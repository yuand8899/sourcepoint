---
// 服务项目线条图标组件。无第三方图标库依赖，全部内联 SVG。
interface Props { name: string; }
const { name } = Astro.props;

const paths: Record<string, string> = {
  // 疼痛管理 — 关节/穴位
  pain: '<circle cx="12" cy="6" r="2.4"/><path d="M12 8.4v5.6"/><path d="M12 14l-3 5"/><path d="M12 14l3 5"/><circle cx="12" cy="14" r="1"/>',
  // 推拿按摩 — 手
  massage: '<path d="M7 11V6.5a1.5 1.5 0 0 1 3 0V11"/><path d="M10 10.5V5a1.5 1.5 0 0 1 3 0v5.5"/><path d="M13 10.5V6a1.5 1.5 0 0 1 3 0v6"/><path d="M16 9.5a1.5 1.5 0 0 1 3 0V14a6 6 0 0 1-6 6h-1a6 6 0 0 1-5.2-3L4 12.5a1.6 1.6 0 0 1 2.7-1.7L7 11"/>',
  // 睡眠压力 — 月亮
  sleep: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>',
  // 消化 — 器官环
  digest: '<path d="M9 3v4a3 3 0 0 0 3 3 3 3 0 0 1 3 3v1a3 3 0 0 1-3 3H9a4 4 0 0 1-4-4"/><path d="M9 3h3"/>',
  // 女性健康
  women: '<circle cx="12" cy="8" r="4.5"/><path d="M12 12.5V21"/><path d="M9 18h6"/>',
  // 儿童
  child: '<circle cx="12" cy="6" r="2.5"/><path d="M12 8.5v6"/><path d="M8 11l4 1.5L16 11"/><path d="M12 14.5 9 21"/><path d="M12 14.5 15 21"/>',
  // 美容
  beauty: '<path d="M12 3l1.8 4.6L18.5 9 14 11l-2 5-2-5L5.5 9l4.7-1.4z"/><circle cx="18" cy="17" r="1"/><circle cx="6" cy="16" r="1"/>',
  // 体重
  weight: '<path d="M5 8h14l-1.5 11a1 1 0 0 1-1 .9H7.5a1 1 0 0 1-1-.9z"/><path d="M9 8a3 3 0 0 1 6 0"/>',
  // 问诊
  consult: '<path d="M12 21s-7-4.35-7-9.5A4.5 4.5 0 0 1 12 8a4.5 4.5 0 0 1 7 3.5C19 16.65 12 21 12 21z"/>',
  // 中药
  herb: '<path d="M12 21c0-5 0-8 4-11"/><path d="M12 12C9 8 5 8 4 6c3-1 7 0 8 4"/><path d="M12 16c1-4 5-5 8-4-1 2-4 2-6 5"/>',
};
const inner = paths[name] ?? paths.consult;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={inner} />
