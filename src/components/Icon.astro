---
// 服务项目线描图标组件。无第三方图标库依赖，全部内联 SVG。
// 统一风格：viewBox 0 0 48 48，细线描（stroke-width 1.5），圆角笔触。
interface Props { name: string; }
const { name } = Astro.props;

const paths: Record<string, string> = {
  // 疼痛管理 — 针灸针 + 穴位点
  pain: `
    <path d="M14 10l16 16"/>
    <path d="M12 8l3 3"/>
    <circle cx="30" cy="26" r="3.5"/>
    <path d="M30 29.5c0 4-2.5 6.5-2.5 9.5"/>
    <circle cx="20" cy="16" r="1"/>
    <circle cx="24" cy="20" r="1"/>`,
  // 运动损伤 — 奔跑的人
  sports: `
    <circle cx="29" cy="11" r="3"/>
    <path d="M27 17l-6 4 4 4 1 8"/>
    <path d="M25 21l7 2 3 5"/>
    <path d="M21 21l-6 2-3 6"/>
    <path d="M26 33l-6 6"/>`,
  // 中医经络推拿 — 手掌 + 经络
  massage: `
    <path d="M16 26V15a2 2 0 0 1 4 0v9"/>
    <path d="M20 24V13a2 2 0 0 1 4 0v11"/>
    <path d="M24 24V14a2 2 0 0 1 4 0v10"/>
    <path d="M28 22a2 2 0 0 1 4 0v7a9 9 0 0 1-9 9h-1a9 9 0 0 1-7.6-4.2l-3.2-5a2 2 0 0 1 3.3-2.2l1.5 2"/>`,
  // 睡眠压力 — 月亮 + 星
  sleep: `
    <path d="M34 26a12 12 0 1 1-14-14 9.5 9.5 0 0 0 14 14z"/>
    <path d="M32 12l1 2.5 2.5 1-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1z"/>`,
  // 消化健康 — 胃/肠环
  digest: `
    <path d="M18 10v6a5 5 0 0 0 5 5 4 4 0 0 1 4 4v1a5 5 0 0 1-5 5h-4a7 7 0 0 1-7-7"/>
    <path d="M18 10h4"/>
    <circle cx="30" cy="14" r="1"/>`,
  // 女性健康 — 女性符号 + 叶
  women: `
    <circle cx="24" cy="17" r="8"/>
    <path d="M24 25v14"/>
    <path d="M18 34h12"/>
    <path d="M24 17c2-2 4-2 6-1-1 2-3 3-6 1z"/>`,
  // 儿童健康 — 孩童剪影
  child: `
    <circle cx="24" cy="13" r="4"/>
    <path d="M24 17v10"/>
    <path d="M15 21l9 3 9-3"/>
    <path d="M24 27l-5 12"/>
    <path d="M24 27l5 12"/>`,
  // 美容针灸 — 面部轮廓 + 光点
  beauty: `
    <path d="M18 12c-3 2-5 6-5 11 0 7 5 13 11 13s11-6 11-13c0-5-2-9-5-11"/>
    <path d="M24 4l1.5 4L30 9.5 25.5 11 24 15l-1.5-4L18 9.5 22.5 8z"/>
    <circle cx="19" cy="24" r="1"/>
    <circle cx="29" cy="24" r="1"/>`,
  // 体重管理 — 秤/天平
  weight: `
    <path d="M12 15h24l-2.5 18a2 2 0 0 1-2 1.8H16.5a2 2 0 0 1-2-1.8z"/>
    <path d="M18 15a6 6 0 0 1 12 0"/>
    <path d="M20 24h8"/>`,
  // 中医问诊 — 脉诊/心手
  consult: `
    <path d="M24 39s-13-8-13-18a8 8 0 0 1 13-6 8 8 0 0 1 13 6c0 10-13 18-13 18z"/>
    <path d="M15 21h5l2-4 3 8 2-4h6"/>`,
  // 中药调理 — 药钵 + 杵 / 草药
  herb: `
    <path d="M12 26h24a12 12 0 0 1-24 0z"/>
    <path d="M14 26c0-3 2-5 5-5"/>
    <path d="M30 20l6-8"/>
    <path d="M24 21c0-5 2-8 6-10-1 4-2 7-6 10z"/>
    <path d="M24 21c-3-3-6-3-9-2 2 3 5 4 9 2z"/>`,
};
const inner = paths[name] ?? paths.consult;
---
<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={inner} /></svg>
