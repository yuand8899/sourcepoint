---
import '../styles/global.css';
import { site, nav, hero, footer, langToggle } from '../data/content';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- 首屏前根据存储/浏览器语言设定 data-lang，避免闪烁 -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('sp-lang');
          var langs = navigator.languages || [navigator.language || 'en'];
          var isZh = langs.some(function (l) { return /^zh/i.test(l); });
          var lang = saved || (isZh ? 'zh' : 'en');
          var el = document.documentElement;
          el.setAttribute('data-lang', lang);
          el.setAttribute('lang', lang === 'zh' ? 'zh-CN' : 'en');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content 跳到正文</a>

    <header class="site-header" id="top">
      <div class="container header-inner">
        <a class="brand" href="#top">
          {site.logo ? (
            <img class="brand-logo" src={site.logo} alt={site.logoAlt.en} />
          ) : (
            <>
              <span class="brand-en lang-en">{site.name.en}</span>
              <span class="brand-zh lang-zh">{site.name.zh}</span>
            </>
          )}
        </a>

        <nav class="nav-desktop" aria-label="Primary">
          {nav.map((item) => (
            <a href={`#${item.id}`}>
              <span class="lang-en">{item.label.en}</span>
              <span class="lang-zh">{item.label.zh}</span>
            </a>
          ))}
        </nav>

        <div class="header-actions">
          <!-- 语言切换按钮 -->
          <button
            id="lang-toggle"
            class="lang-btn"
            type="button"
            aria-label="Switch language 切换语言"
          >
            <span class="lang-en">中</span>
            <span class="lang-zh">EN</span>
          </button>

          <a href="#contact" class="btn btn-primary book-btn">
            <span class="lang-en">{hero.ctaBook.en}</span>
            <span class="lang-zh">{hero.ctaBook.zh}</span>
          </a>

          <button
            id="menu-toggle"
            class="menu-toggle"
            type="button"
            aria-label="Open menu 打开菜单"
            aria-expanded="false"
          >
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>

      <!-- 移动端菜单 -->
      <nav class="nav-mobile" id="nav-mobile" aria-label="Mobile">
        {nav.map((item) => (
          <a href={`#${item.id}`} class="nav-mobile-link">
            <span class="lang-en">{item.label.en}</span>
            <span class="lang-zh">{item.label.zh}</span>
          </a>
        ))}
        <a href="#contact" class="btn btn-primary nav-mobile-link">
          <span class="lang-en">{hero.ctaBook.en}</span>
          <span class="lang-zh">{hero.ctaBook.zh}</span>
        </a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <!-- {site.logo ? (
          <img class="footer-logo" src={site.logo} alt={site.logoAlt.en} />
        ) : (
          <p class="footer-brand">
            <span class="lang-en">{site.name.en}</span>
            <span class="lang-zh">{site.name.zh}</span>
          </p>
        )}
        <p class="footer-tag">
          <span class="lang-en">{site.tagline.en}</span>
          <span class="lang-zh">{site.tagline.zh}</span>
        </p>
        <p class="footer-contact">
          <span>📍 <span class="lang-en">{site.region.en}</span><span class="lang-zh">{site.region.zh}</span></span>
          <span>📞 <a href={`tel:${site.phone}`}>{site.phone}</a></span>
          <span>✉️ <a href={`mailto:${site.email}`}>{site.email}</a></span>
          <span>💬 <span class="lang-en">WeChat</span><span class="lang-zh">微信</span>: {site.wechat}</span>
        </p>  -->
        <p class="footer-legal">
          <span class="lang-en">{footer.rights.en}</span>
          <span class="lang-zh">{footer.rights.zh}</span>
        </p>
        <p class="footer-disclaimer">
          <span class="lang-en">{footer.disclaimer.en}</span>
          <span class="lang-zh">{footer.disclaimer.zh}</span>
        </p>
      </div>
    </footer>

    <script is:inline>
      // ---- 语言切换 ----
      (function () {
        var btn = document.getElementById('lang-toggle');
        var el = document.documentElement;
        if (btn) {
          btn.addEventListener('click', function () {
            var next = el.getAttribute('data-lang') === 'zh' ? 'en' : 'zh';
            el.setAttribute('data-lang', next);
            el.setAttribute('lang', next === 'zh' ? 'zh-CN' : 'en');
            try { localStorage.setItem('sp-lang', next); } catch (e) {}
          });
        }
      })();

      // ---- 移动端菜单 ----
      (function () {
        var toggle = document.getElementById('menu-toggle');
        var menu = document.getElementById('nav-mobile');
        if (!toggle || !menu) return;
        function close() {
          menu.classList.remove('open');
          toggle.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
        }
        toggle.addEventListener('click', function () {
          var open = menu.classList.toggle('open');
          toggle.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        menu.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', close);
        });
      })();

      // ---- 滚动进入动画 ----
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var items = document.querySelectorAll('.reveal');
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach(function (i) { i.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12 });
        items.forEach(function (i) { io.observe(i); });
      })();

      // ---- LOGO / #top 点击回到最顶部（兜底） ----
      // 处理"URL 已是 #top，再点同一锚点浏览器不滚动"的情况，并保证平滑回顶。
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var links = document.querySelectorAll('a[href$="#top"], a[href="#top"]');
        links.forEach(function (el) {
          el.addEventListener('click', function (e) {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
            try { history.replaceState(null, '', location.pathname + '#top'); } catch (err) {}
          });
        });
      })();

      // ---- 顶栏滚动阴影 ----
      (function () {
        var header = document.querySelector('.site-header');
        if (!header) return;
        var onScroll = function () {
          header.classList.toggle('scrolled', window.scrollY > 12);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      })();
    </script>

    <style>
      /* ---- 顶栏 ---- */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(251, 247, 240, 0.86);
        backdrop-filter: saturate(1.4) blur(10px);
        border-bottom: 1px solid transparent;
        transition: border-color 0.25s ease, box-shadow 0.25s ease;
      }
      .site-header.scrolled {
        border-bottom-color: var(--line);
        box-shadow: 0 4px 20px rgba(46, 42, 38, 0.05);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 70px;
      }
      .brand {
        font-family: var(--font-serif);
        font-weight: 700;
        font-size: 1.28rem;
        color: var(--ink);
        letter-spacing: 0.01em;
        white-space: nowrap;
      }
      .brand-zh { letter-spacing: 0.08em; }
      /* 页头 Logo：限定高度，宽度自适应 */
      .brand-logo {
        height: 52px;
        width: auto;
        display: block;
      }
      @media (max-width: 420px) {
        .brand-logo { height: 36px; }
      }

      .nav-desktop { display: flex; gap: 1.6rem; }
      .nav-desktop a {
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--ink-soft);
        position: relative;
        padding: 0.3rem 0;
        transition: color 0.18s ease;
      }
      .nav-desktop a::after {
        content: '';
        position: absolute;
        left: 0; bottom: -2px;
        width: 0; height: 2px;
        background: var(--clay);
        transition: width 0.22s ease;
      }
      .nav-desktop a:hover { color: var(--ink); }
      .nav-desktop a:hover::after { width: 100%; }

      .header-actions { display: flex; align-items: center; gap: 0.7rem; }

      /* 语言切换按钮 */
      .lang-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        border: 1.5px solid var(--clay);
        color: var(--clay);
        background: transparent;
        border-radius: 999px;
        padding: 0.42rem 0.85rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: background 0.18s ease, color 0.18s ease;
        line-height: 1;
      }
      .lang-btn:hover { background: var(--clay); color: var(--white); }
      .lang-btn-hint { font-weight: 500; font-size: 0.82rem; }

      .book-btn { padding: 0.6rem 1.15rem; font-size: 0.92rem; }

      /* 汉堡按钮 */
      .menu-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 42px; height: 42px;
        border: none; background: transparent; cursor: pointer;
        padding: 8px;
      }
      .menu-toggle span {
        display: block; height: 2px; width: 100%;
        background: var(--ink); border-radius: 2px;
        transition: transform 0.25s ease, opacity 0.2s ease;
      }
      .menu-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .menu-toggle.open span:nth-child(2) { opacity: 0; }
      .menu-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

      /* 移动端菜单 */
      .nav-mobile {
        display: none;
        flex-direction: column;
        gap: 0.35rem;
        padding: 0.5rem clamp(1.25rem, 5vw, 2.5rem) 1.2rem;
        border-top: 1px solid var(--line);
        background: var(--cream);
      }
      .nav-mobile.open { display: flex; }
      .nav-mobile-link {
        padding: 0.7rem 0.2rem;
        font-weight: 500;
        color: var(--ink);
        border-bottom: 1px solid var(--line);
      }
      .nav-mobile a.btn { justify-content: center; margin-top: 0.6rem; border-bottom: none; }

      @media (max-width: 940px) {
        .nav-desktop { display: none; }
        .book-btn { display: none; }
        .menu-toggle { display: flex; }
      }
      @media (max-width: 420px) {
        .lang-btn-hint { display: none; }
      }

      /* ---- 页脚 ---- */
      .site-footer {
        background: var(--ink);
        color: #d9d2c8;
        padding-block: clamp(2.5rem, 6vw, 4rem);
        text-align: center;
      }
      .footer-brand {
        font-family: var(--font-serif);
        font-size: 1.4rem;
        color: var(--white);
        margin-bottom: 0.4rem;
      }
      /* 页脚 Logo：居中；深色背景上用 filter 反白（适用于单色 Logo）。
         若 Logo 为多色，请改用 content.ts 里的浅色版字段替换此处 src。 */
      .footer-logo {
        height: 56px;
        width: auto;
        display: block;
        margin: 0 auto 0.8rem;
        filter: brightness(0) invert(1);
        opacity: 0.92;
      }
      .footer-tag { color: var(--clay-soft); font-size: 0.95rem; margin-bottom: 1.4rem; }
      .footer-contact {
        display: flex; flex-wrap: wrap; justify-content: center;
        gap: 0.5rem 1.6rem; font-size: 0.92rem; margin-bottom: 1.4rem;
      }
      .footer-contact a { border-bottom: 1px solid rgba(255,255,255,.25); }
      .footer-contact a:hover { color: var(--white); }
      .footer-legal { font-size: 0.85rem; color: #a49c90; margin-bottom: 0.3rem; }
      .footer-disclaimer { font-size: 0.8rem; color: #8a8278; max-width: 60ch; margin-inline: auto; }
    </style>
  </body>
</html>
