---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {
  site, hero, about, founder, servicesEyebrow, services,
  modalitiesEyebrow, modalities, educationEyebrow, education,
  whyEyebrow, why, vision, contact,
} from '../data/content';

const pageTitle =
  'Sourcepoint Wellness 源真中医 | TCM & Acupuncture · White Rock / South Surrey, BC';
const pageDesc =
  'Sourcepoint Wellness 源真中医 — Traditional Chinese Medicine, acupuncture, herbal medicine and holistic wellness in White Rock / South Surrey, BC. Founded by Yuan Ding (Yolanda Ding), R.TCM.P., R.Ac.';
---
<Base title={pageTitle} description={pageDesc}>
  <!-- ===================== HERO ===================== -->
  <section class="hero" id="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="hero-values reveal">
        <span class="lang-en">{hero.values.en}</span>
        <span class="lang-zh">{hero.values.zh}</span>
      </p>
      <h1 class="hero-title reveal">
        <span class="lang-en">{hero.title.en}</span>
        <span class="lang-zh">{hero.title.zh}</span>
      </h1>
      <p class="hero-sub reveal">
        <span class="lang-en">{hero.subtitle.en}</span>
        <span class="lang-zh">{hero.subtitle.zh}</span>
      </p>
      <p class="hero-body reveal">
        <span class="lang-en">{hero.body.en}</span>
        <span class="lang-zh">{hero.body.zh}</span>
      </p>
      <div class="hero-cta reveal">
        <a href="#contact" class="btn btn-primary">
          <span class="lang-en">{hero.ctaBook.en}</span>
          <span class="lang-zh">{hero.ctaBook.zh}</span>
        </a>
        <a href="#contact" class="btn btn-ghost">
          <span class="lang-en">{hero.ctaContact.en}</span>
          <span class="lang-zh">{hero.ctaContact.zh}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== ABOUT ===================== -->
  <section class="section" id="about">
    <div class="container">
      <p class="eyebrow reveal">
        <span class="lang-en">{about.eyebrow.en}</span>
        <span class="lang-zh">{about.eyebrow.zh}</span>
      </p>
      <div class="about-grid">
        <div class="about-card reveal">
          <h2 class="about-h">
            <span class="lang-en">{about.missionTitle.en}</span>
            <span class="lang-zh">{about.missionTitle.zh}</span>
          </h2>
          {about.mission.map((p) => (
            <p><span class="lang-en">{p.en}</span><span class="lang-zh">{p.zh}</span></p>
          ))}
        </div>
        <div class="about-card reveal">
          <h2 class="about-h">
            <span class="lang-en">{about.philosophyTitle.en}</span>
            <span class="lang-zh">{about.philosophyTitle.zh}</span>
          </h2>
          {about.philosophy.map((p) => (
            <p><span class="lang-en">{p.en}</span><span class="lang-zh">{p.zh}</span></p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FOUNDER ===================== -->
  <section class="section section--alt" id="founder">
    <div class="container founder-grid">
      <div class="founder-photo reveal">
        <img src="/images/founder.jpg" alt="创始人照片 / Founder portrait" />
      </div>
    <div class="founder-text reveal">
        <p class="eyebrow">
          <span class="lang-en">{founder.eyebrow.en}</span>
          <span class="lang-zh">{founder.eyebrow.zh}</span>
        </p>
        <h2 class="section-title founder-name">
          <span class="lang-en">{founder.name.en}</span>
          <span class="lang-zh">{founder.name.zh}</span>
        </h2>
        <ul class="cred-list">
          {founder.credentials.map((c) => (
            <li><span class="lang-en">{c.en}</span><span class="lang-zh">{c.zh}</span></li>
          ))}
        </ul>
        {founder.bio.map((p) => (
          <p class="founder-bio"><span class="lang-en">{p.en}</span><span class="lang-zh">{p.zh}</span></p>
        ))}
        <h3 class="expertise-title">
          <span class="lang-en">{founder.expertiseTitle.en}</span>
          <span class="lang-zh">{founder.expertiseTitle.zh}</span>
        </h3>
        <div class="chip-row">
          {founder.expertise.map((e) => (
            <span class="chip"><span class="lang-en">{e.en}</span><span class="lang-zh">{e.zh}</span></span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="section" id="services">
    <div class="container">
      <p class="eyebrow reveal">
        <span class="lang-en">{servicesEyebrow.en}</span>
        <span class="lang-zh">{servicesEyebrow.zh}</span>
      </p>
      <div class="services-grid">
        {services.map((s) => (
          <article class="service-card reveal">
            <div class="service-icon"><Icon name={s.icon} /></div>
            <h3 class="service-title">
              <span class="lang-en">{s.title.en}</span>
              <span class="lang-zh">{s.title.zh}</span>
            </h3>
            <p class="service-body">
              <span class="lang-en">{s.body.en}</span>
              <span class="lang-zh">{s.body.zh}</span>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== MODALITIES + EDUCATION ===================== -->
  <section class="section section--alt" id="modalities">
    <div class="container two-col">
      <div class="reveal">
        <p class="eyebrow">
          <span class="lang-en">{modalitiesEyebrow.en}</span>
          <span class="lang-zh">{modalitiesEyebrow.zh}</span>
        </p>
        <ul class="tick-list">
          {modalities.map((m) => (
            <li><span class="lang-en">{m.en}</span><span class="lang-zh">{m.zh}</span></li>
          ))}
        </ul>
      </div>
      <div class="reveal" id="education">
        <p class="eyebrow">
          <span class="lang-en">{educationEyebrow.en}</span>
          <span class="lang-zh">{educationEyebrow.zh}</span>
        </p>
        <ul class="tick-list">
          {education.map((e) => (
            <li><span class="lang-en">{e.en}</span><span class="lang-zh">{e.zh}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ===================== WHY CHOOSE US ===================== -->
  <section class="section" id="why">
    <div class="container">
      <p class="eyebrow reveal">
        <span class="lang-en">{whyEyebrow.en}</span>
        <span class="lang-zh">{whyEyebrow.zh}</span>
      </p>
      <div class="why-grid">
        {why.map((w) => (
          <div class="why-item reveal">
            <span class="why-check" aria-hidden="true">✓</span>
            <span><span class="lang-en">{w.en}</span><span class="lang-zh">{w.zh}</span></span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== VISION ===================== -->
  <section class="section section--alt" id="vision">
    <div class="container vision-inner">
      <p class="eyebrow reveal">
        <span class="lang-en">{vision.eyebrow.en}</span>
        <span class="lang-zh">{vision.eyebrow.zh}</span>
      </p>
      <p class="vision-body reveal">
        <span class="lang-en">{vision.body.en}</span>
        <span class="lang-zh">{vision.body.zh}</span>
      </p>
      <div class="vision-pillars reveal">
        {vision.pillars.map((p) => (
          <div class="pillar">
            <span class="lang-en">{p.en}</span>
            <span class="lang-zh">{p.zh}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CONTACT ===================== -->
  <section class="section" id="contact">
    <div class="container contact-grid">
      <div class="contact-info reveal">
        <p class="eyebrow">
          <span class="lang-en">{contact.eyebrow.en}</span>
          <span class="lang-zh">{contact.eyebrow.zh}</span>
        </p>
        <h2 class="section-title">
          <span class="lang-en">{site.legalName.en}</span>
          <span class="lang-zh">{site.legalName.zh}</span>
        </h2>
        <ul class="contact-list">
          <li>
            <span class="c-ico">📍</span>
            <span><span class="lang-en">{site.region.en}</span><span class="lang-zh">{site.region.zh}</span></span>
          </li>
          <li>
            <span class="c-ico">📞</span>
            <a href={`tel:${site.phone}`}>{site.phone}</a>
          </li>
          <li>
            <span class="c-ico">✉️</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <span class="c-ico">💬</span>
            <span><span class="lang-en">WeChat</span><span class="lang-zh">微信</span>: <strong>{site.wechat}</strong></span>
          </li>
        </ul>
        <div class="contact-btns">
          <a href={`mailto:${site.email}`} class="btn btn-primary">
            <span class="lang-en">{contact.emailBtn.en}</span>
            <span class="lang-zh">{contact.emailBtn.zh}</span>
          </a>
          <a href={`tel:${site.phone}`} class="btn btn-ghost">
            <span class="lang-en">{contact.callBtn.en}</span>
            <span class="lang-zh">{contact.callBtn.zh}</span>
          </a>
        </div>
      </div>

      <div class="contact-cta reveal">
        <h3 class="cta-title">
          <span class="lang-en">{contact.ctaTitle.en}</span>
          <span class="lang-zh">{contact.ctaTitle.zh}</span>
        </h3>
        <p class="cta-body">
          <span class="lang-en">{contact.ctaBody.en}</span>
          <span class="lang-zh">{contact.ctaBody.zh}</span>
        </p>
        <a href={`mailto:${site.email}`} class="btn btn-primary cta-btn">
          <span class="lang-en">{contact.bookBtn.en}</span>
          <span class="lang-zh">{contact.bookBtn.zh}</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===================== HERO ===================== */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 12vw, 8rem);
    background: linear-gradient(180deg, var(--cream) 0%, var(--cream-2) 100%);
  }
  .hero-bg {
    position: absolute; inset: 0;
    background: url('/images/hero.jpg') center / cover no-repeat;
    pointer-events: none;
  }
  .hero-inner { position: relative; max-width: 860px; }
  .hero-values {
    font-size: 0.82rem; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--clay); margin-bottom: 1.2rem;
  }
  .hero-title {
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    line-height: 1.08; margin-bottom: 1.2rem;
  }
  .hero-title .lang-zh { letter-spacing: 0.04em; }
  .hero-sub {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.6vw, 1.6rem);
    color: var(--clay-dark); margin-bottom: 1.5rem; max-width: 30ch;
  }
  .hero-body {
    font-size: 1.08rem; color: var(--ink-soft);
    max-width: 56ch; margin-bottom: 2rem;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  /* ===================== ABOUT ===================== */
  .about-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 1.5rem; margin-top: 1.5rem;
  }
  .about-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.6rem, 3vw, 2.4rem);
    box-shadow: var(--shadow);
  }
  .about-h { font-size: 1.4rem; margin-bottom: 1rem; color: var(--clay-dark); }

  /* ===================== FOUNDER ===================== */
  .founder-grid {
    display: grid; grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 4rem); align-items: start;
  }
  .founder-photo {
    position: sticky; top: 90px;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: linear-gradient(135deg, var(--clay-soft), var(--sage));
    box-shadow: var(--shadow-lg);
  }
  .photo-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    text-align: center; color: rgba(255,255,255,.92);
    font-size: 0.9rem; line-height: 1.6; padding: 1.5rem;
    background: rgba(46,42,38,.14);
  }
  .founder-name { margin-bottom: 1.2rem; }
  .cred-list { list-style: none; padding: 0; margin: 0 0 1.5rem; }
  .cred-list li {
    position: relative; padding-left: 1.4rem; margin-bottom: 0.5rem;
    font-weight: 600; color: var(--ink);
  }
  .cred-list li::before {
    content: ''; position: absolute; left: 0; top: 0.62em;
    width: 8px; height: 8px; border-radius: 50%; background: var(--clay);
  }
  .founder-bio { color: var(--ink-soft); margin-bottom: 1rem; }
  .expertise-title {
    font-size: 1.15rem; margin: 1.8rem 0 1rem; color: var(--clay-dark);
  }
  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    background: var(--cream); border: 1px solid var(--line);
    padding: 0.4rem 0.85rem; border-radius: 999px;
    font-size: 0.88rem; color: var(--ink-soft);
  }

  /* ===================== SERVICES ===================== */
  .services-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem; margin-top: 1.5rem;
  }
  .service-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.7rem;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .service-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .service-icon {
    width: 48px; height: 48px; margin-bottom: 1rem;
    display: flex; align-items: center; justify-content: center;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(194,99,46,.12), rgba(232,167,107,.18));
    color: var(--clay);
  }
  .service-icon svg { width: 26px; height: 26px; }
  .service-title { font-size: 1.18rem; margin-bottom: 0.6rem; }
  .service-body { font-size: 0.95rem; color: var(--ink-soft); }

  /* ===================== MODALITIES + EDUCATION ===================== */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); }
  .tick-list { list-style: none; padding: 0; margin: 1.2rem 0 0; }
  .tick-list li {
    position: relative; padding: 0.7rem 0 0.7rem 1.9rem;
    border-bottom: 1px solid var(--line); font-weight: 500;
  }
  .tick-list li::before {
    content: '✓'; position: absolute; left: 0; top: 0.7rem;
    color: var(--sage); font-weight: 700;
  }

  /* ===================== WHY ===================== */
  .why-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1rem; margin-top: 1.5rem;
  }
  .why-item {
    display: flex; align-items: flex-start; gap: 0.7rem;
    background: var(--cream-2); border-radius: var(--radius-sm);
    padding: 1.1rem 1.2rem; font-weight: 500;
  }
  .why-check {
    flex: none; width: 24px; height: 24px; border-radius: 50%;
    background: var(--clay); color: var(--white);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.85rem; font-weight: 700;
  }

  /* ===================== VISION ===================== */
  .vision-inner { max-width: 820px; }
  .vision-body {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    line-height: 1.5; margin-bottom: 2rem;
  }
  .vision-pillars {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
  }
  .pillar {
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 1rem; text-align: center;
    font-weight: 600; font-size: 0.95rem;
    color: var(--ink);
  }
  /* ===================== CONTACT ===================== */
  .contact-grid {
    display: grid; grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 3.5rem); align-items: stretch;
  }
  .contact-list { list-style: none; padding: 0; margin: 1.5rem 0; }
  .contact-list li {
    display: flex; align-items: center; gap: 0.8rem;
    padding: 0.7rem 0; border-bottom: 1px solid var(--line);
    font-size: 1.02rem;
  }
  .c-ico { font-size: 1.15rem; flex: none; }
  .contact-list a { border-bottom: 1px solid var(--clay); color: var(--clay-dark); }
  .contact-btns { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.5rem; }

  .contact-cta {
    background: linear-gradient(155deg, var(--clay), var(--clay-dark));
    color: var(--white);
    border-radius: var(--radius);
    padding: clamp(2rem, 4vw, 3rem);
    display: flex; flex-direction: column; justify-content: center;
    box-shadow: var(--shadow-lg);
  }
  .cta-title { color: var(--white); font-size: 1.6rem; margin-bottom: 1rem; }
  .cta-body { color: rgba(255,255,255,.9); margin-bottom: 1.8rem; }
  .contact-cta .cta-btn {
    background: var(--white); color: var(--clay-dark); align-self: flex-start;
  }
  .contact-cta .cta-btn:hover { background: var(--cream); }

  /* ===================== 响应式 ===================== */
  @media (max-width: 940px) {
    .about-grid,
    .services-grid,
    .why-grid { grid-template-columns: 1fr 1fr; }
    .founder-grid { grid-template-columns: 1fr; }
    .founder-photo { position: static; max-width: 380px; }
    .vision-pillars { grid-template-columns: 1fr 1fr; }
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .about-grid,
    .services-grid,
    .why-grid,
    .two-col,
    .vision-pillars { grid-template-columns: 1fr; }
    .hero-cta .btn,
    .contact-btns .btn { flex: 1 1 auto; justify-content: center; }
  }
</style>
