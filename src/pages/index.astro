---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import {
  site, hero, about, founder, services, vision, community, contact,
} from "../data/content.ts";
---
<Base
  title="Sourcepoint Wellness 源真中医 | TCM & Acupuncture · White Rock / South Surrey, BC"
  description="Sourcepoint Wellness 源真中医 — Traditional Chinese Medicine, acupuncture, herbal medicine and holistic wellness in White Rock / South Surrey, BC. Founded by Yuan Ding, R.Ac."
>

  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="hero-bg ph">Hero banner image / 首页横幅图<br/>(replace public/images/hero.jpg)</div>
    <div class="hero-overlay"></div>
    <div class="container hero-inner">
      <div class="hero-copy reveal">
        <h1 class="hero-title">
          <span class="ht-en">{site.nameEn}</span>
          <span class="ht-zh">{site.nameZh}</span>
        </h1>
        <p class="hero-tag-en">{hero.tagEn}</p>
        <p class="hero-tag-zh">{hero.tagZh}</p>
        <span class="hero-divider"></span>
        <p class="hero-lead-en">{hero.leadEn}</p>
        <p class="hero-lead-zh">{hero.leadZh}</p>
        <p class="hero-pillars-en">{hero.pillarsEn}</p>
        <p class="hero-pillars-zh">{hero.pillarsZh}</p>
        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary">
            <span class="btn-stack"><span class="en">Book a Consultation</span><span class="zh">预约咨询</span></span>
          </a>
          <a href="#contact" class="btn btn-ghost">
            <span class="btn-stack"><span class="en">Contact Us</span><span class="zh">联系我们</span></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== ABOUT ===================== -->
  <section id="about" class="section">
    <div class="container about-grid">
      <div class="reveal">
        <div class="section-head">
          <h2 class="h-en">About Sourcepoint Wellness</h2>
          <div class="h-zh">关于源真中医</div>
          <div class="rule"></div>
        </div>
        <p class="lead-en">{about.p1En}</p>
        <p class="lead-zh" style="margin:8px 0 20px;">{about.p1Zh}</p>
        <p class="lead-en">{about.p2En}</p>
        <p class="lead-zh" style="margin-top:8px;">{about.p2Zh}</p>
      </div>
      <aside class="mission-card reveal">
        <div class="mission-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" width="42" height="42">
            <path d="M24 34 C16 30 10 24 10 18 a6 6 0 0 1 14 -2 a6 6 0 0 1 14 2 c0 6 -6 12 -14 16 Z"
              fill="none" stroke="var(--clay)" stroke-width="1.6"/>
          </svg>
        </div>
        <h3 class="h-en" style="font-size:1.5rem;">Our Mission</h3>
        <div class="h-zh">我们的使命</div>
        <p class="lead-en" style="margin-top:16px;">{about.missionEn}</p>
        <p class="lead-zh" style="margin-top:10px;">{about.missionZh}</p>
      </aside>
    </div>
  </section>

  <!-- ===================== FOUNDER ===================== -->
  <section id="founder" class="section section--alt">
    <div class="container founder-grid">
      <div class="founder-photo ph reveal">Founder portrait / 创始人照片<br/>(replace public/images/founder.jpg)</div>

      <div class="founder-body reveal">
        <div class="section-head">
          <h2 class="h-en">Meet Our Founder</h2>
          <div class="h-zh">创始人介绍</div>
          <div class="rule"></div>
        </div>
        <h3 class="founder-name-en">{founder.nameEn}</h3>
        <div class="founder-name-zh">{founder.nameZh}</div>
        <ul class="creds">
          {founder.creds.map((c) => (
            <li><Icon name="check" /><span><b>{c.en}</b> <span class="muted">{c.zh}</span></span></li>
          ))}
        </ul>
        <p class="lead-en" style="margin-top:6px;">{founder.noteEn}</p>
        <p class="lead-zh" style="margin-top:6px;">{founder.noteZh}</p>
      </div>

      <aside class="expertise reveal">
        <h4 class="exp-title">Areas of Expertise <span>专业领域</span></h4>
        <ul>
          {founder.expertise.map((e) => (
            <li><Icon name="check" /><span>{e.en}　<span class="muted">{e.zh}</span></span></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section id="services" class="section">
    <div class="container">
      <div class="section-head center reveal">
        <h2 class="h-en">Our Services</h2>
        <div class="h-zh">服务项目</div>
        <div class="rule"></div>
      </div>
      <div class="svc-grid">
        {services.map((s) => (
          <article class="svc-card reveal">
            <div class="svc-icon"><Icon name={s.icon} /></div>
            <h3 class="svc-en">{s.en}</h3>
            <div class="svc-zh">{s.zh}</div>
            <p class="svc-desc-en">{s.descEn}</p>
            <p class="svc-desc-zh">{s.descZh}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== VISION ===================== -->
  <section id="vision" class="section section--alt">
    <div class="container vision-grid">
      <div class="reveal">
        <div class="section-head">
          <h2 class="h-en">Our Vision</h2>
          <div class="h-zh">我们的愿景</div>
          <div class="rule"></div>
        </div>
        <p class="lead-en">{vision.introEn}</p>
        <p class="lead-zh" style="margin-bottom:14px;">{vision.introZh}</p>
        <ul class="vision-list">
          {vision.items.map((v) => (
            <li><Icon name="check" /><span>{v.en}　<span class="muted">{v.zh}</span></span></li>
          ))}
        </ul>
        <p class="lead-en" style="margin-top:16px;">{vision.closeEn}</p>
        <p class="lead-zh">{vision.closeZh}</p>
      </div>
      <div class="vision-photo ph reveal">Zen / herbal still-life image<br/>禅意配图 (replace public/images/vision.jpg)</div>
    </div>
  </section>

  <!-- ===================== COMMUNITY ===================== -->
  <section id="community" class="section">
    <div class="container">
      <div class="section-head center reveal">
        <h2 class="h-en">Growing with the Community</h2>
        <div class="h-zh">与社区共同成长</div>
        <div class="rule"></div>
      </div>
      <p class="community-lead reveal">
        <span class="lead-en">{community.leadEn}</span><br/>
        <span class="lead-zh">{community.leadZh}</span>
      </p>
      <div class="comm-grid">
        {community.items.map((c) => (
          <div class="comm-card reveal">
            <div class="comm-dot" aria-hidden="true"></div>
            <div class="comm-en">{c.en}</div>
            <div class="comm-zh">{c.zh}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CONTACT ===================== -->
  <section id="contact" class="section section--alt">
    <div class="container contact-grid">
      <div class="reveal">
        <div class="section-head">
          <h2 class="h-en">Contact Us</h2>
          <div class="h-zh">联系我们</div>
          <div class="rule"></div>
        </div>
        <ul class="contact-list">
          <li><span class="ci">📍</span><span>{site.location.en}<br/><span class="muted">{site.location.zh}</span></span></li>
          <li><span class="ci">📞</span><a href={`tel:${site.phone}`}>{site.phone}</a></li>
          <li><span class="ci">✉️</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><span class="ci">💬</span><span>WeChat 微信：<b>{site.wechat}</b></span></li>
        </ul>
        <div class="contact-actions">
          <a href={`mailto:${site.email}`} class="btn btn-primary">
            <span class="btn-stack"><span class="en">Email Us</span><span class="zh">发送邮件</span></span>
          </a>
          <a href={`tel:${site.phone}`} class="btn btn-ghost">
            <span class="btn-stack"><span class="en">Call Now</span><span class="zh">电话联系</span></span>
          </a>
        </div>
      </div>

      <aside class="cta-card reveal">
        <h3 class="h-en" style="font-size:1.6rem;">{contact.ctaEn}</h3>
        <div class="h-zh">{contact.ctaZh}</div>
        <p class="lead-en" style="margin-top:16px;">{contact.ctaBodyEn}</p>
        <p class="lead-zh" style="margin-top:8px;">{contact.ctaBodyZh}</p>
        <a href={`mailto:${site.email}`} class="btn btn-primary" style="margin-top:22px;">
          <span class="btn-stack"><span class="en">Book a Consultation</span><span class="zh">预约咨询</span></span>
        </a>
      </aside>
    </div>
  </section>

</Base>

<style>
  .hero { position: relative; min-height: 620px; display: flex; align-items: center; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; min-height: 100%; border: none; border-radius: 0; }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(100deg, rgba(251,247,240,.96) 0%, rgba(251,247,240,.85) 40%, rgba(251,247,240,.30) 70%, rgba(251,247,240,0) 100%);
  }
  .hero-inner { position: relative; padding: 70px 24px; }
  .hero-copy { max-width: 620px; }
  .hero-title { display: flex; flex-direction: column; margin-bottom: 14px; }
  .ht-en { font-size: clamp(2.4rem, 5vw, 3.6rem); letter-spacing: .5px; }
  .ht-zh { font-size: clamp(1.8rem, 3.6vw, 2.6rem); color: var(--ink); }
  .hero-tag-en { font-size: 1.05rem; color: var(--ink-2); font-weight: 500; }
  .hero-tag-zh { font-size: .98rem; color: var(--ink-2); }
  .hero-divider { display: block; width: 60px; height: 3px; background: var(--clay); margin: 18px 0; border-radius: 2px; }
  .hero-lead-en { font-size: 1.05rem; color: var(--ink); }
  .hero-lead-zh { font-size: 1rem; color: var(--ink-2); margin-bottom: 16px; }
  .hero-pillars-en { color: var(--clay-dark); font-weight: 600; letter-spacing: .3px; }
  .hero-pillars-zh { color: var(--clay-dark); font-weight: 500; font-size: .95rem; }
  .hero-actions { display: flex; gap: 14px; margin-top: 26px; flex-wrap: wrap; }

  .about-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 46px; align-items: start; }
  .mission-card { background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 34px; box-shadow: var(--shadow); }
  .mission-icon { margin-bottom: 10px; }

  .founder-grid { display: grid; grid-template-columns: 300px 1.3fr 0.9fr; gap: 40px; align-items: start; }
  .founder-photo { min-height: 360px; }
  .founder-name-en { font-size: 1.5rem; margin-top: 4px; }
  .founder-name-zh { color: var(--clay); font-family: var(--serif); font-size: 1.1rem; margin-bottom: 18px; }
  .creds { list-style: none; display: flex; flex-direction: column; gap: 12px; margin-bottom: 8px; }
  .creds li, .expertise li, .vision-list li { display: flex; gap: 10px; align-items: flex-start; }
  .creds :global(.icon svg), .expertise :global(.icon svg), .vision-list :global(.icon svg) { width: 20px; height: 20px; flex: none; margin-top: 3px; }
  .expertise { background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 28px; box-shadow: var(--shadow); }
  .exp-title { font-family: var(--serif); font-size: 1.15rem; margin-bottom: 18px; color: var(--ink); }
  .exp-title span { color: var(--ink-3); font-size: .9rem; font-weight: 400; }
  .expertise ul { list-style: none; display: flex; flex-direction: column; gap: 12px; }

  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .svc-card {
    background: var(--card); border: 1px solid var(--line); border-radius: 16px;
    padding: 30px 26px; text-align: center; box-shadow: var(--shadow);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .svc-card:hover { transform: translateY(-4px); box-shadow: 0 14px 40px rgba(70,50,30,.12); }
  .svc-icon { display: flex; justify-content: center; margin-bottom: 14px; }
  .svc-en { font-size: 1.2rem; }
  .svc-zh { color: var(--clay); font-family: var(--serif); margin-bottom: 12px; }
  .svc-desc-en { font-size: .9rem; color: var(--ink-2); }
  .svc-desc-zh { font-size: .88rem; color: var(--ink-3); margin-top: 6px; }

  .vision-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 46px; align-items: center; }
  .vision-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .vision-photo { min-height: 340px; }

  .community-lead { text-align: center; max-width: 720px; margin: 0 auto 40px; }
  .comm-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .comm-card { text-align: center; padding: 26px 18px; border: 1px solid var(--line); border-radius: 14px; background: var(--card); }
  .comm-dot { width: 40px; height: 40px; margin: 0 auto 14px; border-radius: 50%; background: var(--cream-2); border: 2px solid var(--clay-soft); position: relative; }
  .comm-dot::after { content: ""; position: absolute; inset: 10px; border-radius: 50%; background: var(--clay); }
  .comm-en { font-family: var(--serif); color: var(--ink); font-size: 1rem; }
  .comm-zh { color: var(--ink-3); font-size: .88rem; margin-top: 4px; }

  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 46px; align-items: center; }
  .contact-list { list-style: none; display: flex; flex-direction: column; gap: 16px; margin-bottom: 24px; }
  .contact-list li { display: flex; gap: 12px; align-items: flex-start; }
  .contact-list .ci { font-size: 1.15rem; }
  .contact-list a:hover { color: var(--clay); }
  .contact-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .cta-card { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 40px; box-shadow: var(--shadow); }

  @media (max-width: 940px) {
    .about-grid, .founder-grid, .vision-grid, .contact-grid { grid-template-columns: 1fr; }
    .svc-grid { grid-template-columns: repeat(2, 1fr); }
    .comm-grid { grid-template-columns: repeat(2, 1fr); }
    .founder-photo { max-width: 320px; }
  }
  @media (max-width: 560px) {
    .svc-grid, .comm-grid { grid-template-columns: 1fr; }
    .section { padding: 60px 0; }
  }
</style>
