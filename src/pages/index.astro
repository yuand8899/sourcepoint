---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {
  site, hero, about, founder, servicesEyebrow, services,
  modalitiesEyebrow, modalities, educationEyebrow, education,
  whyEyebrow, why, billingEyebrow, billing, vision, contact,
} from '../data/content';

const pageTitle =
  'Sourcepoint Wellness 源真中医 | TCM & Acupuncture · White Rock / South Surrey, BC';
const pageDesc =
  'Sourcepoint Wellness 源真中医 — Traditional Chinese Medicine, acupuncture, herbal medicine and holistic wellness in White Rock / South Surrey, BC. Founded by Yuan Ding (Yolanda Ding), R.TCM.P., R.Ac.';
---
<Base title={pageTitle} description={pageDesc}>
  <!-- ===================== HERO ===================== -->
  <section class="hero" id="hero">
    <div class="container hero-grid">
      <div class="hero-inner reveal">        
        <p class="hero-values">
          <span class="lang-en">{hero.values.en}</span>
          <span class="lang-zh">{hero.values.zh}</span>
        </p>
        <h1 class="hero-title">
          <span class="lang-en">{hero.title.en}</span>
          <span class="lang-zh">{hero.title.zh}</span>
        </h1>
        <p class="hero-sub">
          <span class="lang-en">{hero.subtitle.en}</span>
          <span class="lang-zh">{hero.subtitle.zh}</span>
        </p>
        <p class="hero-body">
          <span class="lang-en">{hero.body.en}</span>
          <span class="lang-zh">{hero.body.zh.map((p) => <span class="hero-body-p">{p}</span>)}</span>
        </p>
        <div class="hero-cta">
          <a href="#contact" class="btn btn-primary">
            <span class="lang-en">{hero.ctaBook.en}</span>
            <span class="lang-zh">{hero.ctaBook.zh}</span>
          </a>
          <a href="#contact" class="btn btn-ghost">
            <span class="lang-en">{hero.ctaContact.en}</span>
            <span class="lang-zh">{hero.ctaContact.zh}</span>
          </a>
        </div>
      </div>
      <div class="hero-media reveal">
        <img class="hero-img" src={hero.image} alt={hero.imageAlt.en} />
      </div>
    </div>
  </section>

  <!-- ===================== ABOUT ===================== -->
  <section class="section" id="about">
    <div class="container">
      <p class="eyebrow reveal">
        <span class="lang-en">{about.eyebrow.en}</span>
        <span class="lang-zh">{about.eyebrow.zh}</span>
      </p>
      <div class="about-grid">
        <div class="about-intro reveal">
          <h2 class="section-title">
            <span class="lang-en">About Sourcepoint Wellness</span>
            <span class="lang-zh">关于源真中医</span>
          </h2>
          {about.intro.map((p) => (
            <p class="about-intro-p"><span class="lang-en">{p.en}</span><span class="lang-zh">{p.zh}</span></p>
          ))}
        </div>
        <div class="about-cards">
          <div class="about-card about-card--ink reveal">
            <h3 class="about-h">
              <span class="lang-en">{about.missionTitle.en}</span>
              <span class="lang-zh">{about.missionTitle.zh}</span>
            </h3>
            {about.mission.map((p) => (
              <p><span class="lang-en">{p.en}</span><span class="lang-zh">{p.zh}</span></p>
            ))}
          </div>
          <div class="about-card about-card--ink reveal">
            <h3 class="about-h">
              <span class="lang-en">{about.philosophyTitle.en}</span>
              <span class="lang-zh">{about.philosophyTitle.zh}</span>
            </h3>
            {about.philosophy.map((p) => (
              <p><span class="lang-en">{p.en}</span><span class="lang-zh">{p.zh}</span></p>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FOUNDER ===================== -->
  <section class="section section--alt" id="founder">
    <div class="container founder-grid">
      <div class="founder-photo reveal">
        <img src="/images/founder.jpg" alt="创始人照片 / Founder portrait" />
      </div>
    <div class="founder-text reveal">
        <p class="eyebrow">
          <span class="lang-en">{founder.eyebrow.en}</span>
          <span class="lang-zh">{founder.eyebrow.zh}</span>
        </p>
        <h2 class="section-title founder-name">
          <span class="lang-en">{founder.name.en}</span>
          <span class="lang-zh">{founder.name.zh}</span>
        </h2>
        <ul class="cred-list">
          {founder.credentials.map((c) => (
            <li><span class="lang-en">{c.en}</span><span class="lang-zh">{c.zh}</span></li>
          ))}
        </ul>
        {founder.bio.map((p) => (
          <p class="founder-bio"><span class="lang-en">{p.en}</span><span class="lang-zh">{p.zh}</span></p>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="section" id="services">
    <div class="container">
      <p class="eyebrow reveal">
        <span class="lang-en">{servicesEyebrow.en}</span>
        <span class="lang-zh">{servicesEyebrow.zh}</span>
      </p>
      <div class="services-grid">
        {services.map((s) => (
          <article class="service-card reveal">
            <div class="service-icon"><Icon name={s.icon} /></div>
            <h3 class="service-title">
              <span class="lang-en">{s.title.en}</span>
              <span class="lang-zh">{s.title.zh}</span>
            </h3>
            <p class="service-body">
              <span class="lang-en">{s.body.en}</span>
              <span class="lang-zh">{s.body.zh}</span>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== MODALITIES + EDUCATION ===================== -->
  <section class="section section--alt" id="modalities">
    <div class="container two-col">
      <div class="reveal">
        <p class="eyebrow">
          <span class="lang-en">{modalitiesEyebrow.en}</span>
          <span class="lang-zh">{modalitiesEyebrow.zh}</span>
        </p>
        <ul class="tick-list">
          {modalities.map((m) => (
            <li><span class="lang-en">{m.en}</span><span class="lang-zh">{m.zh}</span></li>
          ))}
        </ul>
      </div>
      <div class="reveal" id="education">
        <p class="eyebrow">
          <span class="lang-en">{educationEyebrow.en}</span>
          <span class="lang-zh">{educationEyebrow.zh}</span>
        </p>
        <ul class="tick-list">
          {education.map((e) => (
            <li><span class="lang-en">{e.en}</span><span class="lang-zh">{e.zh}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ===================== WHY CHOOSE US ===================== -->
  <section class="section" id="why">
    <div class="container">
      <p class="eyebrow reveal">
        <span class="lang-en">{whyEyebrow.en}</span>
        <span class="lang-zh">{whyEyebrow.zh}</span>
      </p>
      <div class="why-grid">
        {why.map((w) => (
          <div class="why-item reveal">
            <span class="why-check" aria-hidden="true">✓</span>
            <span><span class="lang-en">{w.en}</span><span class="lang-zh">{w.zh}</span></span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== INSURANCE & BILLING ===================== -->
  <section class="section section--alt" id="billing">
    <div class="container billing-inner">
      <p class="eyebrow reveal">
        <span class="lang-en">{billingEyebrow.en}</span>
        <span class="lang-zh">{billingEyebrow.zh}</span>
      </p>
      <ul class="billing-list reveal">
        {billing.map((b) => (
          <li>
            <span class="lang-en">{b.en}</span>
            <span class="lang-zh">{b.zh}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== VISION ===================== -->
  <section class="section section--alt" id="vision">
    <div class="container vision-inner">
      <p class="eyebrow reveal">
        <span class="lang-en">{vision.eyebrow.en}</span>
        <span class="lang-zh">{vision.eyebrow.zh}</span>
      </p>
      <p class="vision-body reveal">
        <span class="lang-en">{vision.body.en}</span>
        <span class="lang-zh">{vision.body.zh}</span>
      </p>
    </div>
  </section>

  <!-- ===================== CONTACT ===================== -->
  <section class="section" id="contact">
    <div class="container contact-grid">
      <div class="contact-info reveal">
        <p class="eyebrow">
          <span class="lang-en">{contact.eyebrow.en}</span>
          <span class="lang-zh">{contact.eyebrow.zh}</span>
        </p>
        <h2 class="section-title">
          <span class="lang-en">{site.legalName.en}</span>
          <span class="lang-zh">{site.legalName.zh}</span>
        </h2>
        <ul class="contact-list">
          <li>
            <span class="c-ico">🕒</span>
            <span><span class="lang-en">{contact.hours.en}</span><span class="lang-zh">{contact.hours.zh}</span></span>
          </li>
          <li>
            <span class="c-ico">📍</span>
            <span><span class="lang-en">{site.region.en}</span><span class="lang-zh">{site.region.zh}</span></span>
          </li>
          <li>
            <span class="c-ico">📞</span>
            <a href={`tel:${site.phone}`}>{site.phone}</a>
          </li>
          <li>
            <span class="c-ico">✉️</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <span class="c-ico">💬</span>
            <span><span class="lang-en">WeChat</span><span class="lang-zh">微信</span>: <strong>{site.wechat}</strong></span>
          </li>
        </ul>
        <div class="contact-btns">
          <a href={`mailto:${site.email}`} class="btn btn-primary">
            <span class="lang-en">{contact.emailBtn.en}</span>
            <span class="lang-zh">{contact.emailBtn.zh}</span>
          </a>
          <a href={`tel:${site.phone}`} class="btn btn-ghost">
            <span class="lang-en">{contact.callBtn.en}</span>
            <span class="lang-zh">{contact.callBtn.zh}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===================== 全局节奏覆盖 ===================== */
  /* 加大区块垂直留白，让每个 section 更有呼吸感（西式审美偏好） */
  .section { padding-block: clamp(4.5rem, 9vw, 8rem); }
  .eyebrow { margin-bottom: 0.4rem; }
  .section-title { text-wrap: balance; }

  /* ===================== HERO ===================== */
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--cream) 0%, var(--cream-2) 100%);
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .hero-inner { max-width: 560px; }
  .hero-logo {
    height: clamp(48px, 6vw, 68px);
    width: auto;
    margin-bottom: 1.6rem;
    display: block;
  }
  .hero-values {
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--clay);
    margin-bottom: 1.2rem;
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 5.5vw, 4.2rem);
    line-height: 1.06; margin-bottom: 1.1rem;
    color: var(--clay-dark);
    text-wrap: balance;
  }
  .hero-title .lang-zh { letter-spacing: 0.04em; }
  .hero-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    color: var(--clay); margin-bottom: 1.5rem; max-width: 34ch;
  }
  .hero-body {
    font-size: 1.06rem; line-height: 1.7;
    color: var(--ink-soft);
    max-width: 52ch; margin-bottom: 2.2rem;
  }
  .hero-body-p { display: block; margin-bottom: 0.7rem; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  /* 右侧配图 */
  .hero-media {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background: linear-gradient(135deg, var(--clay-soft), var(--sage));
  }
  .hero-img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ===================== ABOUT ===================== */
  .about-grid {
    display: grid; grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4rem); margin-top: 1.5rem;
    align-items: start;
  }
  .about-intro .section-title { margin-bottom: 1.4rem; }
  .about-intro-p { color: var(--ink-soft); font-size: 1.05rem; margin-bottom: 1rem; }
  .about-cards { display: flex; flex-direction: column; gap: 1.2rem; }
  .about-card {
    position: relative;
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.6rem, 3vw, 2.2rem);
    box-shadow: var(--shadow);
  }
  /* CSS 水墨底纹：右上角几团柔和的暖色晕染，模拟宣纸水墨 */
  .about-card--ink::before {
    content: '';
    position: absolute;
    top: -30%; right: -20%;
    width: 70%; height: 90%;
    background:
      radial-gradient(45% 45% at 70% 30%, rgba(194,99,46,0.10), transparent 70%),
      radial-gradient(40% 40% at 40% 60%, rgba(111,122,90,0.08), transparent 70%),
      radial-gradient(50% 50% at 60% 70%, rgba(232,167,107,0.10), transparent 70%);
    filter: blur(6px);
    pointer-events: none;
  }
  .about-card > * { position: relative; }
  .about-h { font-size: 1.3rem; margin-bottom: 0.9rem; color: var(--clay-dark); }
  .about-card p { color: var(--ink-soft); font-size: 0.98rem; }

  /* ===================== FOUNDER ===================== */
  .founder-grid {
    display: grid; grid-template-columns: 340px 1fr;
    gap: clamp(2rem, 5vw, 4rem); align-items: start;
  }
  .founder-text { max-width: 62ch; }
  .founder-photo {
    position: sticky; top: 90px;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: linear-gradient(135deg, var(--clay-soft), var(--sage));
    box-shadow: var(--shadow-lg);
  }
  .founder-name {
    margin-bottom: 1.2rem;
    text-wrap: balance;
    hyphens: none;
  }
  .cred-list { list-style: none; padding: 0; margin: 0 0 1.5rem; }
  .cred-list li {
    position: relative; padding-left: 1.4rem; margin-bottom: 0.5rem;
    font-weight: 600; color: var(--ink);
  }
  .cred-list li::before {
    content: ''; position: absolute; left: 0; top: 0.62em;
    width: 8px; height: 8px; border-radius: 50%; background: var(--clay);
  }
  .founder-bio { color: var(--ink-soft); margin-bottom: 1rem; }

  /* ===================== SERVICES ===================== */
  .services-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem; margin-top: 1.5rem;
    align-items: stretch;
  }
  .service-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.7rem;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .service-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .service-icon {
    width: 56px; height: 56px; margin-bottom: 1.1rem;
    display: flex; align-items: center; justify-content: center;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(194,99,46,.12), rgba(232,167,107,.18));
    color: var(--clay);
  }
  .service-icon svg { width: 30px; height: 30px; }
  .service-title {
    font-size: 1.18rem; margin-bottom: 0.6rem;
    text-wrap: balance;
  }
  .service-body {
    font-size: 1rem;          /* 原 0.95rem，略放大 */
    line-height: 1.7;         /* 原 1.65，再松一点 */
    color: var(--ink);        /* 原 var(--ink-soft)，改用更深的主文字色 */
  }

  /* ===================== MODALITIES + EDUCATION ===================== */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.5rem, 6vw, 5rem); }
  .tick-list { list-style: none; padding: 0; margin: 1.6rem 0 0; }
  .tick-list li {
    position: relative; padding: 0.95rem 0 0.95rem 1.9rem;
    border-bottom: 1px solid var(--line);
    font-weight: 500; font-size: 1.02rem;
  }
  .tick-list li::before {
    content: '✓'; position: absolute; left: 0; top: 0.95rem;
    color: var(--sage); font-weight: 700;
  }

  /* ===================== WHY ===================== */
  .why-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem 2.2rem; margin-top: 2rem;
  }
  .why-item {
    display: flex; align-items: flex-start; gap: 0.8rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 500; line-height: 1.5;
  }
  /* 简洁细勾，去掉圆形色块，减轻"清单页"观感 */
  .why-check {
    flex: none;
    color: var(--clay);
    font-size: 1rem; font-weight: 700;
    line-height: 1.5;
  }

  /* ===================== INSURANCE & BILLING ===================== */
  .billing-inner { max-width: 1000px; }
  .billing-list {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 0.8rem; margin-top: 1.4rem; list-style: none; padding: 0;
  }
  .billing-list li {
    position: relative; padding: 0.9rem 1.1rem 0.9rem 2.6rem;
    background: var(--white); border: 1px solid var(--line);
    border-radius: var(--radius-sm); font-weight: 600; color: var(--ink);
  }
  .billing-list li::before {
    content: '✓'; position: absolute; left: 1.1rem; top: 0.9rem;
    color: var(--sage); font-weight: 700;
  }

  /* ===================== VISION ===================== */
  .vision-inner { max-width: 780px; text-align: center; }
  .vision-inner .eyebrow { justify-content: center; }
  .vision-body {
    position: relative;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);   /* 原 clamp(1.25rem, 2.8vw, 1.75rem)，上限降到 1.55 */     
    line-height: 1.75;                          /* 原 1.6，提高让行间更松 */
    color: var(--clay-dark);
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(2rem, 4vw, 2.8rem) clamp(1.5rem, 5vw, 3rem);
    box-shadow: var(--shadow);
    margin: 0.5rem 0 0;
  }
  .vision-body::before {
    content: '\201C';
    position: absolute;
    top: 0.2em;              /* 正值,收进卡片内 */
    left: 0.3em;
    font-size: 5rem;         /* 放大,原来大概 3.2rem,大了才像装饰 */
    line-height: 1;
    color: var(--clay-soft);
    opacity: 0.35;           /* 调淡,像水印 */
    font-family: var(--font-serif);
  }

  /* ===================== CONTACT ===================== */
  .contact-grid {
    display: grid; grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 3.5rem); align-items: stretch;
  }
  .contact-list { list-style: none; padding: 0; margin: 1.5rem 0; }
  .contact-list li {
    display: flex; align-items: center; gap: 0.8rem;
    padding: 0.7rem 0; border-bottom: 1px solid var(--line);
    font-size: 1.02rem;
  }
  .c-ico { font-size: 1.15rem; flex: none; }
  .contact-list a { border-bottom: 1px solid var(--clay); color: var(--clay-dark); }
  .contact-btns { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.5rem; }

  /* ===================== 响应式 ===================== */
  @media (max-width: 940px) {
    .about-grid { grid-template-columns: 1fr; }
    .services-grid,
    .billing-list { grid-template-columns: 1fr 1fr; }
    .why-grid { grid-template-columns: 1fr 1fr; gap: 0.2rem 1.6rem; }
    .founder-grid { grid-template-columns: 1fr; }
    .founder-text { max-width: none; }
    .founder-photo { position: static; max-width: 340px; }
    .contact-grid { grid-template-columns: 1fr; }
    /* hero 分栏在窄屏叠成单列：文字在上，图片在下 */
    .hero-grid { grid-template-columns: 1fr; }
    .hero-inner { max-width: none; }
    .hero-media { aspect-ratio: 16 / 10; max-height: 420px; }
  }
  @media (max-width: 560px) {
    .about-grid,
    .services-grid,
    .why-grid,
    .two-col,
    .billing-list { grid-template-columns: 1fr; }
    .hero-cta .btn,
    .contact-btns .btn { flex: 1 1 auto; justify-content: center; }
  }
</style>
