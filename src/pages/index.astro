---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {
  site, hero, whyChoose, practitioner, services, firstVisit, insurance, contact,
} from '../data/content';

const pageTitle =
  'SourcePoint Wellness 源真中医 | TCM & Acupuncture · White Rock / South Surrey, BC';
const pageDesc =
  'SourcePoint Wellness 源真中医 — Traditional Chinese Medicine, acupuncture, herbal medicine and holistic wellness in White Rock / South Surrey, BC. Founded by Yuan Ding (Yolanda Ding), R.TCM.P., R.Ac.';

// 简单的特色卡片图标（内联 SVG），风格与全站细线描一致
const whyIcons: Record<string, string> = {
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
  badge:
    '<path d="M12 3l2.4 1.7 2.9-.2 1 2.8 2.5 1.5-.9 2.8.9 2.8-2.5 1.5-1 2.8-2.9-.2L12 21l-2.4-1.7-2.9.2-1-2.8L3.2 15l.9-2.8L3.2 9.4l2.5-1.5 1-2.8 2.9.2z"/><path d="m9 12 2 2 4-4"/>',
  evidence: '<path d="M4 19V5a2 2 0 0 1 2-2h9l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M14 3v5h5"/><path d="M8 13h8"/><path d="M8 16h5"/>',
  heart: '<path d="M12 20s-7-4.5-9.2-9C1.3 8 3 4.5 6.5 4.5c2 0 3.3 1.2 4.1 2.4l1.4 1.9 1.4-1.9c.8-1.2 2.1-2.4 4.1-2.4C21 4.5 22.7 8 21.2 11 19 15.5 12 20 12 20z"/>',
};
---
<Base title={pageTitle} description={pageDesc}>
  <!-- ===================== HERO ===================== -->
  <section class="hero" id="hero">
    <div class="container hero-grid">
      <div class="hero-inner reveal">
        <p class="hero-eyebrow">
          <span class="lang-en">{hero.tagline.en}</span>
          <span class="lang-zh">{hero.tagline.zh}</span>
        </p>
        <h1 class="hero-title">
          <span class="lang-en">
            {hero.title.en.split(' · ').map((part) => <span class="title-line">{part}</span>)}
          </span>
          <span class="lang-zh">{hero.title.zh}</span>
        </h1>
        <p class="hero-sub">
          <span class="lang-en">{hero.subtitle.en}</span>
          <span class="lang-zh">{hero.subtitle.zh}</span>
        </p>
        <p class="hero-body">
          <span class="lang-en">{hero.intro.en.map((p) => <span class="hero-body-p">{p}</span>)}</span>
          <span class="lang-zh">{hero.intro.zh.map((p) => <span class="hero-body-p">{p}</span>)}</span>
        </p>
        <ul class="hero-highlights">
          {hero.highlights.map((h) => (
            <li>
              <span class="hl-check" aria-hidden="true">✓</span>
              <span><span class="lang-en">{h.en}</span><span class="lang-zh">{h.zh}</span></span>
            </li>
          ))}
        </ul>
        <div class="hero-cta">
          <a href="#contact" class="btn btn-primary">
            <span class="lang-en">{hero.ctaContact.en}</span>
            <span class="lang-zh">{hero.ctaContact.zh}</span>
          </a>
        </div>
      </div>

      <div class="hero-media reveal">
        <img class="hero-img" src={hero.image} alt={hero.imageAlt.en} />
        <img src="/images/logo-s.png" alt="" class="hero-media-logo" aria-hidden="true" />
        <div class="hero-overlay" aria-hidden="false">
          <div class="hero-overlay-zh lang-zh">
            {hero.imageQuote.zh.map((line) => <span class="hero-overlay-line">{line}</span>)}
          </div>
          <div class="hero-overlay-en lang-en">
            {hero.imageQuote.en.map((line) => <span class="hero-overlay-line">{line}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== WHY CHOOSE ===================== -->
  <section class="section section--alt" id="about">
    <div class="container why-wrap">
      <p class="eyebrow reveal why-eyebrow">
        <span class="lang-en">{whyChoose.heading.eyebrow.en}</span>
        <span class="lang-zh">{whyChoose.heading.eyebrow.zh}</span>
      </p>
      <h2 class="section-title why-title reveal">
        <span class="lang-en">{whyChoose.heading.title.en}</span>
        <span class="lang-zh">{whyChoose.heading.title.zh}</span>
      </h2>
      <p class="why-sub reveal">
        <span class="lang-en">{whyChoose.heading.sub?.en}</span>
        <span class="lang-zh">{whyChoose.heading.sub?.zh}</span>
      </p>
      <div class="why-grid">
        {whyChoose.cards.map((w) => (
          <article class="why-card reveal">
            <div class="why-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={whyIcons[w.icon] ?? whyIcons.plus} /></svg>
            </div>
            <h3 class="why-card-title">
              <span class="lang-en">{w.title.en}</span>
              <span class="lang-zh">{w.title.zh}</span>
            </h3>
            <p class="why-card-body">
              <span class="lang-en">{w.body.en}</span>
              <span class="lang-zh">{w.body.zh}</span>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== PRACTITIONER ===================== -->
  <section class="section" id="practitioner">
    <div class="container founder-grid">
      <div class="founder-photo reveal">
        <img src="/images/founder.jpg" alt="丁源医师照片 / Yolanda Ding portrait" />
      </div>
      <div class="founder-text reveal">
        <p class="eyebrow">
          <span class="lang-en">{practitioner.heading.eyebrow.en}</span>
          <span class="lang-zh">{practitioner.heading.eyebrow.zh}</span>
        </p>
        <h2 class="section-title founder-title">
          <span class="lang-en">{practitioner.heading.title.en}</span>
          <span class="lang-zh">{practitioner.heading.title.zh}</span>
        </h2>
        <p class="founder-name">
          <span class="lang-en">{practitioner.name.en}</span>
          <span class="lang-zh">{practitioner.name.zh}</span>
        </p>
        <ul class="cred-tags">
          {practitioner.credentials.map((c) => (
            <li><span class="lang-en">{c.en}</span><span class="lang-zh">{c.zh}</span></li>
          ))}
        </ul>
        <div class="founder-bio-cols">
          {practitioner.bio.map((p, i) => (
            <p class={i === practitioner.bio.length - 1 ? 'founder-bio founder-quote' : 'founder-bio'}>
              <span class="lang-en">{p.en}</span><span class="lang-zh">{p.zh}</span>
            </p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="section section--alt" id="services">
    <div class="container">
      <p class="eyebrow reveal">
        <span class="lang-en">{services.heading.eyebrow.en}</span>
        <span class="lang-zh">{services.heading.eyebrow.zh}</span>
      </p>
      <h2 class="section-title reveal">
        <span class="lang-en">{services.heading.title.en}</span>
        <span class="lang-zh">{services.heading.title.zh}</span>
      </h2>
      <p class="services-sub reveal">
        <span class="lang-en">{services.heading.sub?.en}</span>
        <span class="lang-zh">{services.heading.sub?.zh}</span>
      </p>
      <div class="services-grid">
        {services.items.map((s) => (
          <article class="service-card reveal">
            <div class="service-icon"><Icon name={s.icon} /></div>
            <h3 class="service-title">
              <span class="lang-en">{s.title.en}</span>
              <span class="lang-zh">{s.title.zh}</span>
            </h3>
            <p class="service-body">
              <span class="lang-en">{s.body.en}</span>
              <span class="lang-zh">{s.body.zh}</span>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== FIRST VISIT ===================== -->
  <section class="section" id="firstvisit">
    <div class="container fv-wrap">
      <p class="eyebrow reveal fv-eyebrow">
        <span class="lang-en">{firstVisit.heading.eyebrow.en}</span>
        <span class="lang-zh">{firstVisit.heading.eyebrow.zh}</span>
      </p>
      <h2 class="section-title fv-title reveal">
        <span class="lang-en">{firstVisit.heading.title.en}</span>
        <span class="lang-zh">{firstVisit.heading.title.zh}</span>
      </h2>
      <div class="fv-grid">
        {firstVisit.steps.map((f) => (
          <article class="fv-card reveal">
            <span class="fv-step">{f.step}</span>
            <h3 class="fv-card-title">
              <span class="lang-en">{f.title.en}</span>
              <span class="lang-zh">{f.title.zh}</span>
            </h3>
            <p class="fv-card-body">
              <span class="lang-en">{f.body.en}</span>
              <span class="lang-zh">{f.body.zh}</span>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== INSURANCE & BILLING ===================== -->
  <section class="section section--alt" id="insurance">
    <div class="container">
      <div class="billing-card reveal">
        <div class="billing-text">
          <p class="eyebrow billing-eyebrow">
            <span class="lang-en">{insurance.heading.eyebrow.en}</span>
            <span class="lang-zh">{insurance.heading.eyebrow.zh}</span>
          </p>
          <h2 class="billing-title">
            <span class="lang-en">{insurance.heading.title.en}</span>
            <span class="lang-zh">{insurance.heading.title.zh}</span>
          </h2>
          <p class="billing-body">
            <span class="lang-en">{insurance.intro.en}</span>
            <span class="lang-zh">{insurance.intro.zh}</span>
          </p>
        </div>
        <div class="billing-tags">
          {insurance.providers.map((b) => (
            <div class="billing-tag">
              <span class="billing-tag-name">
                <span class="lang-en">{b.name.en}</span>
                <span class="lang-zh">{b.name.zh}</span>
              </span>
              {(b.note.en || b.note.zh) && (
                <span class="billing-tag-note">
                  <span class="lang-en">{b.note.en}</span>
                  <span class="lang-zh">{b.note.zh}</span>
                </span>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CONTACT ===================== -->
  <section class="section" id="contact">
    <div class="container">
      <div class="contact-head reveal">
        <p class="eyebrow">
          <span class="lang-en">{contact.heading.eyebrow.en}</span>
          <span class="lang-zh">{contact.heading.eyebrow.zh}</span>
        </p>
        <div class="contact-title-row">
          <img src="/images/logo-s.png" alt="" class="contact-logo" aria-hidden="true" />
          <h2 class="section-title">
            <span class="lang-en">{site.legalName.en}</span>
            <span class="lang-zh">{site.legalName.zh}</span>
          </h2>
        </div>
      </div>

      <div class="contact-grid">
        <div class="contact-info reveal">
        <ul class="contact-list">
          <li>
            <span class="c-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            </span>
            <span><span class="lang-en">{contact.hours.en}</span><span class="lang-zh">{contact.hours.zh}</span></span>
          </li>
          <li>
            <span class="c-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            </span>
            <span><span class="lang-en">{site.address.en}</span><span class="lang-zh">{site.address.zh}</span></span>
          </li>
          <li>
            <span class="c-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5c0 9 6 15 15 15v-4l-4-1-2 2c-3-1.5-5.5-4-7-7l2-2-1-4z"/></svg>
            </span>
            <a href={`tel:${site.phone}`}>{site.phone}</a>
          </li>
          <li>
            <span class="c-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <span class="c-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg>
            </span>
            <a href={site.facebook} target="_blank" rel="noopener">
              <span class="lang-en">Facebook</span><span class="lang-zh">Facebook 主页</span>
            </a>
          </li>
        </ul>

        <!-- 英文版按钮：放在 Facebook 下方（英文版右列不显示二维码） -->
        <div class="contact-btns contact-btns--en lang-en">
          <a href={`mailto:${site.email}`} class="btn btn-primary">{contact.emailBtn.en}</a>
          <a href={`tel:${site.phone}`} class="btn btn-ghost">{contact.callBtn.en}</a>
        </div>
        </div>

        <div class="contact-qr reveal">
          <!-- 微信二维码仅在中文版显示（英文访客通常不使用微信） -->
          <div class="qr-frame lang-zh">
            {site.wechatQr
              ? <img src={site.wechatQr} alt="微信二维码 / WeChat QR" class="qr-img" />
              : <div class="qr-fallback" aria-hidden="true"></div>}
          </div>
          <p class="qr-hint lang-zh">{contact.qrHint.zh}</p>
          <div class="contact-btns lang-zh">
            <a href={`mailto:${site.email}`} class="btn btn-primary">
              <span class="lang-en">{contact.emailBtn.en}</span>
              <span class="lang-zh">{contact.emailBtn.zh}</span>
            </a>
            <a href={`tel:${site.phone}`} class="btn btn-ghost">
              <span class="lang-en">{contact.callBtn.en}</span>
              <span class="lang-zh">{contact.callBtn.zh}</span>
            </a>
          </div>
        </div>

        <div class="contact-map reveal">
          <iframe
            src={contact.mapEmbedSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
            title="SourcePoint Wellness location / 诊所位置"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .section { padding-block: clamp(4.5rem, 9vw, 8rem); }
  .eyebrow { margin-bottom: 0.4rem; }
  /* 统一：所有区块标题单行显示 + 与 HERO 标题同色（clay-dark） */
  .section-title {
    white-space: nowrap;
    color: var(--clay-dark);
    max-width: none;
  }

  /* ===================== HERO ===================== */
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--cream) 0%, var(--cream-2) 100%);
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: stretch;   /* 图片撑满行高，与左栏等高 */
  }
  .hero-inner { max-width: 560px; }
  .hero-eyebrow {
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--clay);
    margin-bottom: 1.1rem;
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    line-height: 1.08; margin-bottom: 1.1rem;
    color: var(--clay-dark);
    white-space: nowrap;   /* 标题不换行 */
  }
  .hero-title .lang-zh { letter-spacing: 0.04em; }
  /*.hero-title .lang-en { white-space: nowrap; }*/
  .hero-title .lang-en .title-line {display: block;} /* 每段换行 */
  .hero-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.15rem, 2.3vw, 1.5rem);
    color: var(--clay); margin-bottom: 1.5rem; max-width: 34ch;
  }
  .hero-body {
    font-size: 1.04rem; line-height: 1.7;
    color: var(--ink-soft);
    max-width: 52ch; margin-bottom: 2.2rem;
  }
  .hero-body-p { display: block; margin-bottom: 0.7rem; }
  /* Hero 要点：2×2 对勾网格 */
  .hero-highlights {
    list-style: none; padding: 0;
    margin: 0 0 2rem;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 0.7rem 1.4rem;
    max-width: 52ch;
  }
  .hero-highlights li {
    display: flex; align-items: flex-start; gap: 0.6rem;
    font-size: 0.98rem; line-height: 1.4;
    color: var(--ink);
  }
  .hl-check {
    flex: none;
    width: 22px; height: 22px; margin-top: 1px;
    display: grid; place-content: center;
    border-radius: 999px;
    background: rgba(194,99,46,0.12);
    color: var(--clay);
    font-size: 0.72rem; font-weight: 700;
  }
  @media (max-width: 560px) {
    .hero-highlights { grid-template-columns: 1fr; }
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  /* 右侧配图：顶部与 subtitle 对齐（margin-top 下压 eyebrow+title 高度），
     底部随左栏拉伸等高，不再用固定高瘦比例 */
  .hero-media {
    position: relative;
    margin-top: var(--hero-media-offset, 0);
    align-self: stretch;
    min-height: 340px;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background: linear-gradient(135deg, var(--clay-soft), var(--sage));
  }
  .hero-media-logo {
    position: absolute;
    top: 24px; /*clamp(1rem, 2.5vw, 1.6rem); */
    right: 24px; /*clamp(1rem, 2.5vw, 1.6rem);*/
    height: clamp(44px, 9vw, 72px);*/   /* 直接定高,给个最小值 28px */
    width: auto;
    z-index: 2;
    filter: drop-shadow(0 2px 8px rgba(46,42,38,0.7));
  }
  .hero-img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  /* 图片上叠加的竖排寄语 */
  .hero-overlay {
    /* 原有属性保留,追加这一行 */
    transform: translateY(-1.2em);
    /* 把这一行的渐变加深 */    
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0.55rem;
    padding: clamp(1.6rem, 3.5vw, 2.6rem);
    background: linear-gradient(90deg, rgba(46,42,38,0.62) 0%, rgba(46,42,38,0.30) 55%, transparent 100%);
  }
  .hero-overlay-zh,
  .hero-overlay-en { display: flex; flex-direction: column; gap: 0.5rem; }
  .hero-overlay-line {
    font-family: var(--font-serif);
    color: var(--white);
    font-weight: 600;
    letter-spacing: 0.14em;
    /* 用双层阴影：一层近实描边感 + 一层扩散 */
    text-shadow:
      0 1px 2px rgba(46,42,38,0.9),
      0 2px 14px rgba(46,42,38,0.6);
    line-height: 1.2;
  }
  .hero-overlay-zh .hero-overlay-line { font-size: clamp(1.5rem, 3vw, 2.1rem); }
  .hero-overlay-en .hero-overlay-line {
    font-size: clamp(1.15rem, 2.2vw, 1.55rem);
    font-style: italic;
    letter-spacing: 0.06em;
  }

  /* 用 JS 精确对齐时的桌面近似偏移；窄屏归零 */
  @media (min-width: 941px) {
    .hero-media { --hero-media-offset: clamp(3.4rem, 5vw, 4.6rem); }
  }

  /* ===================== WHY CHOOSE ===================== */
  .why-wrap { text-align: left; }
  .why-title {
    max-width: none; margin: 0 0 0.9rem;
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
  }
  /* 英文标题过长，允许换行并平衡两行；中文短标题仍单行 */
  .why-title .lang-en {
    white-space: normal;
    display: inline-block;
    max-width: 24ch;
    text-wrap: balance;
    line-height: 1.15;
  }
  .why-sub { color: var(--ink-soft); margin: 0 0 2.6rem; max-width: 60ch; }
  .why-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1.3rem; text-align: left;
  }
  .why-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.8rem 1.5rem;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .why-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .why-icon {
    width: 52px; height: 52px; margin-bottom: 1.1rem;
    display: grid; place-content: center;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(194,99,46,.12), rgba(232,167,107,.18));
    color: var(--clay);
  }
  .why-icon svg { width: 26px; height: 26px; }
  .why-card-title { font-size: 1.12rem; margin-bottom: 0.6rem; color: var(--clay-dark); }
  .why-card-body { font-size: 0.94rem; line-height: 1.6; color: var(--ink-soft); }

  /* ===================== FOUNDER ===================== */
  .founder-grid {
    display: grid; grid-template-columns: 340px 1fr;
    gap: clamp(2rem, 5vw, 4rem); align-items: start;
  }
