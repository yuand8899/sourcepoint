<script is:inline>
  /* Hero 右图顶部与 subtitle 精确对齐：把图片下压 = eyebrow 行高 + title 高度 + 二者下边距 */
  (function () {
    function alignHeroMedia() {
      var media = document.querySelector('.hero-media');
      var eyebrow = document.querySelector('.hero-eyebrow');
      var title = document.querySelector('.hero-title');
      if (!media || !eyebrow || !title) return;
      if (window.matchMedia('(max-width: 940px)').matches) {
        media.style.marginTop = '0px';
        return;
      }
      var offset =
        eyebrow.offsetHeight +
        parseFloat(getComputedStyle(eyebrow).marginBottom || '0') +
        title.offsetHeight +
        parseFloat(getComputedStyle(title).marginBottom || '0');
      media.style.marginTop = offset + 'px';
    }
    window.addEventListener('load', alignHeroMedia);
    window.addEventListener('resize', alignHeroMedia);
    alignHeroMedia();
  })();
</script>
